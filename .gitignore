# Cargo build outputs.
/target
/build/
Cargo.lock.bak
*.so
*.o
/work/
.beads/
.qmlls.ini

# Build outputs the plugin runtime keeps across updates. `omarchy plugin
# validate` rejects them inside the checkout, so they are ignored here and
# `scripts/setup.sh` mirrors the checkout without deleting them. The helper
# sources and protocol XML stay tracked: they are inputs, not build outputs.
/native/*
!/native/*.c
!/native/*.xml
/.venv/
/backups/

# Release artifacts, built by bin/make-release-artifacts.
/dist/

# makepkg workspace and package artifacts, built by bin/install.
/pkgbuild/pkg/
/pkgbuild/src/
/pkgbuild/*.pkg.tar.*

