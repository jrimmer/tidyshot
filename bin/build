#!/usr/bin/env bash
# bin/build — build tidyshot into build/tidyshot.
#
# The auto-scroll helper is a standalone Wayland program, not part of the
# cargo crate. build.rs builds it during `cargo build` when the toolchain is
# present; this script re-runs bin/native so a release always carries a working
# helper instead of erroring at the first automatic scroll.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p build/native
cargo build --release --offline
bin/native
for helper in scroll-helper window-helper; do
    if [ ! -x "native/$helper" ]; then
        echo "build/tidyshot would have no $helper; install wayland-scanner and wayland-client headers" >&2
        exit 1
    fi
done
cp target/release/tidyshot build/tidyshot
cp target/release/generate-icon build/generate-icon
cp native/scroll-helper native/window-helper build/native/
# The icon follows the live theme; regenerate it for the checkout too.
if [ -n "${HOME:-}" ]; then
    build/generate-icon build/tidyshot.svg >/dev/null
fi
echo "built build/tidyshot"
